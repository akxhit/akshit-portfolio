{
  "name": "akshit-portfolio",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "case-studies/infraone",
    "case-studies/prepinsta-app",
    "case-studies/prepinsta-web",
    "case-studies/zeltgold"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "prepare:portfolio": "node scripts/prepare-portfolio.mjs",
    "predev": "npm run prepare:portfolio",
    "dev": "vinext dev",
    "prebuild": "npm run prepare:portfolio",
    "build": "vinext build",
    "postbuild": "node scripts/finalize-build.mjs",
    "start": "wrangler dev --config dist/server/wrangler.json",
